{
  "name": "@foreman/okx-agent-review-relay-worker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "types": "wrangler types",
    "types:check": "wrangler types --check",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "dry-run": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "startup": "wrangler check startup --outfile worker-startup.cpuprofile",
    "check": "npm run types:check && npm run typecheck && npm test && npm run dry-run && npm run startup",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "wrangler": "4.127.1"
  }
}
